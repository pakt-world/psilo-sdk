     "\"Landing page",
     "\"Landing \ud81b\udea0 page"
    ]
   ],
   "valid": true
  },
  {
   "name": "clock-reading command (allowed by the format; weighing it is evidence law)",
   "replace": [
    [
     "\"java\",",
     "\"sh\", \"-c\", \"test $(date +%s) -lt 1798761600 && java\","
    ]
   ],
   "valid": true
  },
  {
   "name": "expect with stdout hash only, no exit code",
   "replace": [
    [
     "\"expect\": {\n          \"exitCode\": 0\n        }\n      },\n      \"format\": \"PNG",
     "\"expect\": {\n          \"stdoutSha256\": \"0xe3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"\n        }\n      },\n      \"format\": \"PNG"
    ]
   ],
   "valid": false
  },
  {
   "name": "objective test without platform",
   "replace": [
    [
     "\"platform\": \"linux/amd64\",\n        \"command\": [\n          \"java\"",
     "\"command\": [\n          \"java\""
    ]
   ],
   "valid": false
  },
  {
   "name": "unsupported platform",
   "replace": [
    [
     "\"platform\": \"linux/amd64\",\n        \"command\": [\n          \"java\"",
