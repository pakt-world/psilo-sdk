{
 "base": "v1-basic.json",
 "note": "Each case applies text replacements to the base file and states whether hash.py and hash.ts must accept it. Both implementations read this file.",
 "cases": [
  {
   "name": "vector as is (LF inside description is allowed)",
   "replace": [],
   "valid": true
  },
  {
   "name": "space before a line break",
   "replace": [
    [
     "page.\\nCopy",
     "page. \\nCopy"
    ]
   ],
   "valid": false
  },
  {
   "name": "blank line (two line breaks)",
   "replace": [
    [
     "page.\\nCopy",
     "page.\\n\\nCopy"
    ]
   ],
   "valid": false
  },
  {
   "name": "line starting with a space",
   "replace": [
    [
     "page.\\nCopy",
     "page.\\n Copy"
    ]
   ],
   "valid": false
  },
  {
   "name": "NFD cafe in title",
   "replace": [
    [
     "caf\u00e9",
     "cafe\u0301"
    ]
   ],
   "valid": false
  },
  {
   "name": "trailing ZWSP in format",
   "replace": [
    [
     "\"PNG, 1920x1080\"",
     "\"PNG, 1920x1080\u200b\""
    ]
   ],
   "valid": false
  },
  {
   "name": "format character U+0600 (not in the schema's list) inside a description",
   "replace": [
    [
     "Hero images in the brand palette",
     "Hero images in the \u0600brand palette"
    ]
   ],
   "valid": false
  },
  {
   "name": "RLO inside a stated check",
   "replace": [
    [
     "warm, plain words",
     "warm, \u202eplain words"
    ]
   ],
   "valid": false
  },
  {
   "name": "whitespace-only stated check",
   "replace": [
    [
     "\"The copy follows the tone section of the brand guide: warm, plain words, no superlatives.\"",
     "\"   \""
    ]
   ],
   "valid": false
  },
  {
   "name": "leading space in title",
   "replace": [
    [
     "\"Landing page",
     "\" Landing page"
    ]
   ],
   "valid": false
  },
  {
   "name": "trailing newline escape in title",
   "replace": [
    [
     "a caf\u00e9\"",
     "a caf\u00e9\\n\""
    ]
